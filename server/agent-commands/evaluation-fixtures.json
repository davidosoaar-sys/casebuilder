      "command": "DISCOVER_BRAND",
      "company": "Example",
      "website": "https://company.example/",
      "html": "<img alt=\"Customer logo\" src=\"/customer.svg\"><a href=\"/\" aria-label=\"Example home\"><img alt=\"Example\" src=\"/official.svg\"></a>",
      "expected": {
        "logoUrl": "https://company.example/official.svg"
      }
    },
    {
