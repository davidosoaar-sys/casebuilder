# Copy to ~/.config/casebuilder/worker.env (chmod 600). Never commit real values.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SECRET_KEY=
# Optional
# CB_MODEL=claude-sonnet-5-5
# CB_TOOLSETS=web,memory,todo
# Waitlist approval emails (Gmail app password, 16 letters, no spaces)
# GMAIL_USER=casebuilder.app@gmail.com
# GMAIL_APP_PASSWORD=
# CB_APP_URL=https://casebuilder-three.vercel.app
# Optional live read-only accounts (same project and auth configs as Vercel).
# Never use a VITE_ prefix. See docs/composio-setup.md.
# COMPOSIO_API_KEY=
# COMPOSIO_AUTH_GOOGLECALENDAR=
# COMPOSIO_AUTH_GMAIL=
# COMPOSIO_AUTH_SLACK=
# COMPOSIO_AUTH_HUBSPOT=
# Optional tool-version overrides (catalog defaults are pinned in worker.py):
# COMPOSIO_VERSION_GOOGLECALENDAR=20261010_00
# COMPOSIO_VERSION_GMAIL=20261023_00
# COMPOSIO_VERSION_SLACK=20261023_00
# COMPOSIO_VERSION_HUBSPOT=20261026_00
