# Copy to .env.local for local development. On Vercel, set these in
# Project Settings > Environment Variables.

# Required: sign-in and saved deals (Supabase). Without these the app shows
# "This build has no Supabase settings". Both are public by design (they ship
# to every browser; row-level security protects the data). Ask Amr or David
# for the values, or copy them from Supabase > Project Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Required for the people-finder agent.
ANTHROPIC_API_KEY=

# Protects the people-finder AND "Publish to Vercel". Required on a deployed copy:
# without it, publishing is switched off (anyone who found the site could otherwise
# put pages on your Vercel account, or spend your API key). Locally it is optional.
# With one set, the app asks for it once per browser.
RESEARCH_ACCESS_CODE=

# Required for "Publish to Vercel" (the interactive website as its own live link).
# Create a token at https://vercel.com/account/tokens . Each case becomes its own
# Vercel project at https://bc-<company>-<random>.vercel.app
VERCEL_TOKEN=
# Only if your token belongs to a team, or Vercel answers "not allowed". Find the id in
# the Vercel dashboard under Settings > General > Team ID.
VERCEL_TEAM_ID=

# Optional. Defaults to claude-opus-5-5. A cheaper, faster choice: claude-sonnet-5-5
RESEARCH_MODEL=
